# Defence in depth for Apache hosting. Libraries are read through the authenticated service,
# so direct requests for library, backup, lock and temporary files are refused. Other web
# servers need equivalent rules.
Options -Indexes
<FilesMatch "(?i)\.(vcf|csv|bak|lock|tmp|env)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
